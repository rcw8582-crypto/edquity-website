{
  "trailingSlash": false,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/consulting", "destination": "/iep-quality-improvement", "permanent": true },
    { "source": "/for-schools", "destination": "/iep-quality-improvement", "permanent": true },
    { "source": "/donor", "destination": "/donate", "permanent": true },
    { "source": "/scholarship", "destination": "/edquity-scholars", "permanent": true },
    { "source": "/reserve", "destination": "/edquity-scholars", "permanent": true },
    { "source": "/parent-academy", "destination": "/edquity-scholars", "permanent": true }
  ],
  "rewrites": [
    { "source": "/pathways/explore/questions/(.*)", "destination": "/pathways/explore/questions" },
    { "source": "/pathways/explore/fields/(.*)", "destination": "/pathways/explore/fields" },
    { "source": "/pathways/explore/careers/(.*)", "destination": "/pathways/explore" },
    { "source": "/(.*)", "destination": "/" }
  ]
}
